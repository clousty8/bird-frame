# bird-frame — serveur FastAPI — variables d'environnement
# Copier en `.env` (jamais committé, cf. .gitignore) et adapter.
# Toutes les variables sont préfixées BIRDFRAME_ (contrat §7.2). Chemins relatifs résolus
# par rapport au dossier server/.

# Base SQLite du serveur (créée/migrée automatiquement si BIRDFRAME_AUTO_MIGRATE=1)
BIRDFRAME_DB_PATH=data/bird-frame.db

# Dossier de données : clips/<site>/<Genre_espece>/<id>.{wav,png} + photos/<Genre_espece>/{320,1600}.jpg
BIRDFRAME_DATA_DIR=data

# Jeton admin requis pour POST /nodes/register et POST /admin/species-data/reload.
# Vide = ces routes répondent 401 (voir contrat §3). >= 32 caractères recommandé.
BIRDFRAME_ADMIN_TOKEN=change-me-please-at-least-32-characters-long

# Interface et port d'écoute
BIRDFRAME_HOST=127.0.0.1
BIRDFRAME_PORT=8090

# Origines autorisées pour le frontend Vite (séparées par des virgules)
BIRDFRAME_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dossier species-data/ (univers France, base/, sheets/, aliases.json)
BIRDFRAME_SPECIES_DATA_DIR=../species-data

# Exécutable sox pour la génération des spectrogrammes (clips reçus des nœuds)
BIRDFRAME_SOX_PATH=sox

# Taille max d'un upload de clip, en Mo
BIRDFRAME_MAX_UPLOAD_MB=25

# Niveau de journal (DEBUG, INFO, WARNING, ERROR)
BIRDFRAME_LOG_LEVEL=info

# Applique les migrations Alembic automatiquement au démarrage (simplifie S1).
# Mettre à 0 en production si les migrations sont pilotées séparément.
BIRDFRAME_AUTO_MIGRATE=1

# Exemple de configuration bridge pour le site "pornic", S1 (Mac d'Armand).
# Copier en node/config/pornic.env (ignoré par git, permissions 600) et compléter
# BRIDGE_NODE_ID / BRIDGE_SECRET avec la sortie réelle de scripts/register_node.py.
# Référence normative : docs/api-contract.md §7.1.

BRIDGE_SERVER_URL=http://localhost:8090
BRIDGE_NODE_ID=1
BRIDGE_SECRET=remplacer-par-le-bridge_shared_secret-renvoye-par-nodes-register
BRIDGE_SITE_SLUG=pornic
BRIDGE_DB_PATH=/Users/armand_mounsi/Documents/repositories/bird-frame/local-test/data/birdnet.db
BRIDGE_CLIPS_DIR=/Users/armand_mounsi/Documents/repositories/bird-frame/local-test/data/clips
BRIDGE_NODE_API=http://localhost:8080
BRIDGE_SYNC_INTERVAL_S=20
BRIDGE_COMMANDS_INTERVAL_S=30
BRIDGE_HEARTBEAT_INTERVAL_S=60
BRIDGE_STATE_FILE=/Users/armand_mounsi/Documents/repositories/bird-frame/node/state/pornic.json
BRIDGE_BIRDNET_PID_FILE=/Users/armand_mounsi/Documents/repositories/bird-frame/local-test/birdnet-go.pid

# Amendement S1 (contrat §7.1, BRIDGE_NODE_READONLY) : le nœud est l'installation de
# développement local-test/, jamais de mutation contre BirdNET-Go pendant le développement.
BRIDGE_NODE_READONLY=1

# Hors contrat §7.1 (voir node/README.md) : outil optionnel de détection du micro réellement
# capté, utilisé par le heartbeat. Vide/absent = mic_device_name et mic_healthy restent null.
BRIDGE_MIC_STATUS_TOOL=/Users/armand_mounsi/Documents/repositories/bird-frame/local-test/tools/mic-status

<?xml version="1.0" encoding="UTF-8"?>
<!--
  bird-frame — agent launchd du bridge (macOS). Modèle : __ROOT__ et __LABEL__ sont remplacés par
  scripts/install-node.sh, qui installe le résultat dans ~/Library/LaunchAgents/__LABEL__.plist.
  Ne pas éditer la copie installée à la main : relancer install-node.sh.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ROOT__/bin/run-bridge.sh</string>
    <string>__ROOT__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ROOT__</string>

  <!-- Démarre à l'ouverture de session et relance à chaque sortie (plantage, mise à jour). -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Délai minimal entre deux lancements (défaut launchd : 10 s). -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>LANG</key>
    <string>fr_FR.UTF-8</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__ROOT__/logs/bridge.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/logs/bridge.log</string>
</dict>
</plist>

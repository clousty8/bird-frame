# bird-frame — informations de production (Railway), versionnées.
#
# BIRDFRAME_PUBLIC_URL : URL publique du service Railway (ex. https://bird-frame.up.railway.app),
# SANS slash final. Utilisée par .claude/skills/release/SKILL.md pour suivre le déploiement
# après une release (poll de <BIRDFRAME_PUBLIC_URL>/health puis <BIRDFRAME_PUBLIC_URL>/api/v1/nodes)
# et par scripts/dev-up.sh / scripts/build-app.sh comme référence pour leur garde-fou anti-Railway
# (ces scripts ne doivent jamais faire tourner un serveur ou un nœud pointant sur ce domaine).
#
# Valeur vide tant que le service Railway n'a pas encore été créé et son domaine généré — à
# remplir une fois fait (cf. skill "railway" / MCP Railway : generate-domain).
BIRDFRAME_PUBLIC_URL=https://web-production-6eb1d.up.railway.app
